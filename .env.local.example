# Copie para .env.local nesta pasta (app-igreja) e preencha a service role.
# Dashboard: https://supabase.com/dashboard/project/bldbrsuiwctoaxzcrjoc/settings/api
#
# A service role do ecossistema/.env.local pode ser de OUTRO projeto — use a chave
# do projeto app-igreja (bldbrsuiwctoaxzcrjoc) abaixo.

EXPO_PUBLIC_SUPABASE_URL=https://bldbrsuiwctoaxzcrjoc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key_do_projeto_bldbrsuiwctoaxzcrjoc

# Billing SaaS (IBEP + Stripe Test Keys no Cloudflare Pages)
EXPO_PUBLIC_APP_URL=https://seu-dominio.pages.dev
# true = exige plano só na IBEP (outras igrejas não caem no paywall ao trocar de instância)
EXPO_PUBLIC_BILLING_ENFORCE=true
# Secrets só no Cloudflare (não no Expo):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SEMENTE=price_...
# STRIPE_PRICE_CRESCIMENTO=price_...
# STRIPE_PRICE_EXPANSAO=price_...
# STRIPE_PRICE_MINISTERIO=price_...
# SUPABASE_URL=https://bldbrsuiwctoaxzcrjoc.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
