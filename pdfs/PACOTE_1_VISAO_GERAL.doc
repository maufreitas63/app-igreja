<h3>Telas sem ACL de tela</h3>
<table><thead><tr>
<th>Tela</th>
<th>Observação</th>
</tr></thead><tbody>
<tr>
<td>Login</td>
<td>Público</td>
</tr>
<tr>
<td>Cadastro</td>
<td>Público (com <code>?phone=</code>)</td>
</tr>
