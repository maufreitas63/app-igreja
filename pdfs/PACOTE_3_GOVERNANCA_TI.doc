</tr>
<tr>
<td>2</td>
<td><code>member</code></td>
<td>Dados cadastrais</td>
<td>Campos básicos editáveis; sem seção PIN</td>
</tr>
<tr>
<td>3</td>
<td><code>member</code></td>
<td>Abrir Manutenção</td>
<td>Negado (sem engrenagem / sem acesso)</td>
</tr>
<tr>
