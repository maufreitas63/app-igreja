<td><code>access-control-table-rls.sql</code></td>
<td>4 — RLS</td>
</tr>
<tr>
<td>4</td>
<td><code>access-control-admin-rpc.sql</code></td>
<td>4 — UI admin ACL</td>
</tr>
<tr>
<td>5</td>
<td><code>access-control-lider-escala.sql</code></td>
<td>4 — escalas por líder</td>
</tr>
<tr>
<td>6</td>
<td><code>access-control-map-screen.sql</code></td>
