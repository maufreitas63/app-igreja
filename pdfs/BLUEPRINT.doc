</tr>
<tr>
<td><strong>Beneficiário</strong></td>
<td>Eu / família / terceiro (+ campos condicionais)</td>
</tr>
<tr>
<td><strong>Destino</strong></td>
<td>Sigilo pastoral / Intercessão</td>
</tr>
<tr>
<td><strong>Seu pedido</strong></td>
<td>Texto livre</td>
</tr>
<tr>
<td><strong>Histórico (ícone)</strong></td>
<td><code>/pastoral-history</code></td>
</tr>
<tr>
<td><strong>Enviar pedido</strong></td>
<td>RPC <code>submitPastoralRequest</code></td>
</tr>
</tbody></table>
<hr>
